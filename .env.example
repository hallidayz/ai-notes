# Server (app + API)
HOST=0.0.0.0
PORT=4783

# Google OAuth (Calendar + Gmail + Drive) — optional if configured in Settings UI
# In Google Cloud Console: enable Calendar API, Gmail API, Drive API
# OAuth redirect URI must match: http://YOUR_HOST:PORT/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft Calendar (Azure AD)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Notion
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=

# Apple Calendar (iCloud) - Usually requires app-specific password or CalDAV
# For simplicity, we'll use a manual CalDAV connection for Apple
APPLE_CALDAV_URL=
APPLE_USER=
APPLE_PASSWORD=

# Session Secret for Express backend
SESSION_SECRET=your_secure_session_secret_here

# Gemini API (optional — enables cloud analysis; falls back to on-device models without it)
GEMINI_API_KEY=
