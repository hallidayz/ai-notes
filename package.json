{
  "name": "ai-notes",
  "productName": "Acaiguardian",
  "private": true,
  "version": "2.0.0",
  "description": "Private, secure, on-device AI meeting notes",
  "author": {
    "name": "hallidayz"
  },
  "type": "module",
  "main": "electron/main.cjs",
  "repository": {
    "type": "git",
    "url": "https://github.com/hallidayz/ai-notes.git"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "icons": "node scripts/generate-icons.mjs",
    "clean": "node -e \"const fs=require('fs'); for (const d of ['dist','dist-electron','release']) fs.rmSync(d,{recursive:true,force:true});\"",
    "electron:build-server": "node electron/build-server.mjs",
    "electron:build": "npm run build && npm run electron:build-server",
    "electron:dev": "npm run electron:build && cross-env NODE_ENV=production electron .",
    "package:mac": "npm run electron:build && electron-builder --mac --arm64 --x64",
    "package:mac:dmg": "npm run electron:build && electron-builder --mac dmg --arm64 --x64",
    "package:mac:zip": "npm run electron:build && electron-builder --mac zip --arm64 --x64",
    "package:win": "npm run electron:build && electron-builder --win --x64",
    "package:win:portable": "npm run electron:build && electron-builder --win portable --x64"
  },
  "dependencies": {
    "@google/genai": "^1.46.0",
    "@types/express": "^5.0.6",
    "@xenova/transformers": "^2.17.2",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "motion": "^12.38.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsx": "^4.21.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/eslint": "^9.6.1",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "cross-env": "^7.0.3",
    "electron": "^41.2.1",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.25.0",
    "eslint": "^10.0.3",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.4.0",
    "sharp": "^0.34.5",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.57.1",
    "vite": "^6.2.0"
  },
  "build": {
    "appId": "com.hallidayz.acaiguardian",
    "productName": "Acaiguardian",
    "copyright": "Copyright © 2026 hallidayz",
    "directories": {
      "output": "release",
      "buildResources": "electron/assets"
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "!**/*.map",
      "!**/.DS_Store",
      "!**/.git/**",
      "!**/node_modules/.cache/**",
      "!src/**",
      "!server.ts",
      "!server/**"
    ],
    "asar": true,
    "asarUnpack": [
      "**/node_modules/onnxruntime-node/**",
      "**/node_modules/@xenova/transformers/**",
      "**/*.node"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "identity": null,
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "dmg": {
      "title": "${productName} ${version}",
      "writeUpdateInfo": false
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "electron/assets/icon.png",
      "artifactName": "${productName}-${version}-${arch}-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Acaiguardian",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true
    },
    "portable": {
      "artifactName": "${productName}-${version}-${arch}-portable.${ext}"
    },
    "npmRebuild": false
  }
}
